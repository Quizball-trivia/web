    {
      "name": "Guest funnel: view → start → complete → sign-up click → account created",
      "query": {
        "kind": "InsightVizNode",
        "source": {
          "kind": "FunnelsQuery",
          "dateRange": {
            "date_from": "-30d"
          },
          "series": [
            {
              "kind": "EventsNode",
              "event": "game_view",
              "math": "total",
              "properties": [
                {
                  "key": "access_type",
                  "value": [
                    "guest"
                  ],
                  "operator": "exact",
                  "type": "event"
                }
              ]
            },
            {
              "kind": "EventsNode",
              "event": "game_start",
              "math": "total",
              "properties": [
                {
                  "key": "access_type",
                  "value": [
                    "guest"
                  ],
                  "operator": "exact",
                  "type": "event"
                }
              ]
            },
            {
              "kind": "EventsNode",
              "event": "game_complete",
              "math": "total",
              "properties": [
                {
                  "key": "access_type",
                  "value": [
                    "guest"
                  ],
                  "operator": "exact",
                  "type": "event"
                }
              ]
            },
            {
              "kind": "EventsNode",
              "event": "games_signup_click",
              "math": "total"
            },
            {
              "kind": "EventsNode",
              "event": "account_created",
              "math": "total"
            }
          ],
          "funnelsFilter": {
            "funnelWindowInterval": 7,
            "funnelWindowIntervalUnit": "day",
            "funnelVizType": "steps"
          }
        }
      }
    }
  ]
}