{
  "dashboard": {
    "name": "Guest Play — Public games (Production)",
    "description": "Signed-out visitors on the public game pages: who plays what (sneak-peek samples and trainings), completion, exits, languages, sign-up clicks, and the guest→account funnel. access_type is a super property on every event; session_kind = sample|training."
  },
  "insights": [
    {
      "name": "Guest players per day (unique, by session kind)",
      "query": {
        "kind": "InsightVizNode",
        "source": {
          "kind": "TrendsQuery",
          "dateRange": {
            "date_from": "-30d"
          },
          "interval": "day",
          "series": [
            {
              "kind": "EventsNode",
              "event": "game_start",
              "math": "dau",
              "properties": [
                {
                  "key": "access_type",
                  "value": [
                    "guest"
                  ],
                  "operator": "exact",
                  "type": "event"
                }
              ]
            }
          ],
          "trendsFilter": {
            "display": "ActionsLineGraph"
          },
          "breakdownFilter": {
            "breakdown": "session_kind",
            "breakdown_type": "event"
          }
        }
      }
    },
    {
      "name": "Guest plays by game (30d)",
      "query": {
        "kind": "InsightVizNode",
        "source": {
          "kind": "TrendsQuery",
          "dateRange": {
            "date_from": "-30d"
          },
          "interval": "day",
          "series": [
            {
              "kind": "EventsNode",
              "event": "game_start",
              "math": "total",
              "properties": [
                {
                  "key": "access_type",
                  "value": [
                    "guest"
                  ],
                  "operator": "exact",
                  "type": "event"
                }
              ]
            }
          ],
          "trendsFilter": {
            "display": "ActionsBarValue"
          },
          "breakdownFilter": {
            "breakdown": "mode_id",
            "breakdown_type": "event"
          }
        }
      }
    },
    {
      "name": "Guest completion rate",
      "query": {
        "kind": "InsightVizNode",
        "source": {
          "kind": "TrendsQuery",
          "dateRange": {
            "date_from": "-30d"
          },
          "interval": "day",
          "series": [
            {
              "kind": "EventsNode",
              "event": "game_complete",
              "math": "total",
              "properties": [
                {
                  "key": "access_type",
                  "value": [
                    "guest"
                  ],
                  "operator": "exact",
                  "type": "event"
                }
              ]
            },
            {
              "kind": "EventsNode",
              "event": "game_start",
              "math": "total",
              "properties": [
                {
                  "key": "access_type",
                  "value": [
                    "guest"
                  ],
                  "operator": "exact",
                  "type": "event"
                }
              ]
            }
          ],
          "trendsFilter": {
            "display": "ActionsLineGraph",
            "formula": "A/B"
          }
        }
      }
    },
    {
      "name": "Guest exits by stage",
      "query": {
        "kind": "InsightVizNode",
        "source": {
